# Backend Environment Variables
# Copy this file to backend/.env and replace placeholders with actual values.

# Google Gemini AI API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model to use (fast, reliable, free tier friendly)
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database URL
DATABASE_URL=sqlite:///./masal_leads.db

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed CORS origins (frontend URL)
CORS_ORIGINS=http://localhost:5173
